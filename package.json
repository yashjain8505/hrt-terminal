{
  "name": "hrt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "lib": "esbuild src/lib/browser.ts --bundle --format=iife --minify --outfile=public/room/hrt-lib.js --target=es2020",
    "pipeline": "npm run p:universe && npm run p:detect && npm run refresh",
    "refresh": "npm run p:snapshot && npm run p:sec && npm run p:warn && npm run p:geo && npm run p:news && npm run p:diff && npm run p:moves && npm run p:signals && npm run p:situations",
    "p:universe": "tsx scripts/01-universe.ts && tsx scripts/01b-domain-overrides.ts",
    "p:detect": "tsx scripts/02-detect-ats.ts",
    "p:snapshot": "tsx scripts/03-snapshot.ts",
    "p:sec": "tsx scripts/04-sec.ts",
    "p:warn": "tsx scripts/05-warn.ts",
    "p:geo": "tsx scripts/07-geo.ts",
    "p:news": "tsx scripts/12-news.ts",
    "p:diff": "tsx scripts/09-diff.ts",
    "p:moves": "tsx scripts/13-moves.ts",
    "p:signals": "tsx scripts/reclassify.ts && tsx scripts/06-signals.ts",
    "p:situations": "tsx scripts/08-situations.ts",
    "artifacts": "npm run lib && tsx scripts/export-artifacts.ts && tsx scripts/sync-artifacts.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-globe.gl": "^2.38.0",
    "server-only": "^0.0.1",
    "three": "^0.186.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}